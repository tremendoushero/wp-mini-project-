# ========================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file with production secrets.
# ========================================================

# Server Port (Local development default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/student_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/student_db?retryWrites=true&w=majority

# JWT Secret Key (Use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# Frontend URL (Origin of deployed frontend on Vercel for CORS credentials)
# Example: https://students-info.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: SameSite cookie policy override ('none' or 'lax')
# For cross-domain deployment (separate frontend & backend Vercel URLs), leave as 'none'.
# For same-domain / monorepo deployment, 'lax' or 'none' both work.
COOKIE_SAME_SITE=none

# Optional: Custom cookie domain if using shared apex domain (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com
