# ========================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# Copy this file to .env and fill in your real values.
# ========================================================

# Backend API URL:
# 1. For Separate Deployments:
#    Set this to your deployed backend Vercel URL (e.g. https://students-info-api.vercel.app).
# 2. For Monorepo (Single Vercel Project):
#    Leave this empty or set to "" so all requests use relative /api paths.
# 3. For Local Development:
#    Leave undefined or set to http://localhost:5000
VITE_API_URL=https://your-backend.vercel.app
